{
  "schema_version": 1,
  "stage_order": ["title_body_qualification", "manual_content", "manual_page_layout_and_pdf", "code_and_pdf", "txt", "unified_report"],
  "selectable_workflow_options": [
    "match_title_body", "match_software_name", "match_manual_ocr", "match_manual_vision", "match_code", "match_txt",
    "manual_body_years", "manual_image_dates", "manual_cover", "manual_header", "manual_page_numbers", "manual_pdf",
    "code_cleanup", "code_pdf", "txt_repair"
  ],
  "manual_header_and_page_number_selection_independent": true,
  "word_com_parallel": false,
  "manual": {
    "sample_fraction": 0.25,
    "sampling": "equidistant_include_ends",
    "minimum_samples_when_images_exist": 4,
    "ocr_unknown_blocks": false,
    "irrelevant_confidence_threshold": 0.85,
    "project_block_rule": "irrelevant / decisive > 0.5",
    "batch_fuse_rule": "blocked_projects / projects > 0.2",
    "target_year": "per_document: default 2025; use 2026 only when a valid screenshot date in 2026 is not later than the local run date; any valid future 2026 screenshot date keeps the whole document target at 2025",
    "screenshot_date_policy": "scan valid date fields once; use exact dates and first-of-month anchors for year-month fields to choose the per-document target; rewrite future 2026 fields to 2025; preserve month/day and format; keep uncertain OCR unchanged",
    "body_year_decisions": ["UPDATE_TO_TARGET_YEAR", "KEEP", "REVIEW"],
    "body_year_write_rule": "UPDATE_TO_TARGET_YEAR and confidence >= 0.85; preserve historical, standards, and version contexts; when screenshot-date processing is selected but skipped or fails, skip body-year writes because no shared target was established; when screenshot-date processing is not selected, retain the default target-year behavior",
    "preserve_page_size": true,
    "complete_missing_label": true,
    "cover_page_scan_limit": 5,
    "cover_name_source": "unique_txt_stem_else_project_folder",
    "cover_always_runs_word_audit": true,
    "cover_requires_pdf_export_and_full_book_scan": true,
    "cover_word_rules_version": "3.4.28",
    "cover_block_excludes_tables_and_toc": true,
    "cover_leading_noncover_table_policy": "fail_with_manual_review_before_range_zero_insert",
    "cover_version_removal_on_protected_table": "manual_review_without_cell_write",
    "cover_typography_requires_contiguous_same_page_title_and_label": true,
    "blank_page_audit_reuse": "inside_repair_only_while_layout_unchanged; refresh_after_break_or_section_mutation_and_terminal_compaction_or_restore; independent_final_word_and_pdf_audits_preserved",
    "blank_page_audit_excludes_headers_footers": true,
    "cover_targeted_retry_limit": 1,
    "cover_failure_restores_docx_pdf_pair": true,
    "cover_recovery_journal_persisted_with_output": true,
    "cover_startup_recovers_interrupted_processed_siblings": true,
    "cover_report_fields": ["name_source", "name_conflicts", "page_audit", "pdf_audit", "confirmed_blank_pages", "broken_bookmark_fields_unlinked", "attempts", "snapshot_restored", "failures", "cover_typography_workload", "word_blank_page_audit_count", "cover_label_layout_failed"],
    "pdf_audit_fields": ["bookmark_errors"],
    "pdf_bookmark_error_patterns": ["错误!未定义书签。", "Error! Bookmark not defined."],
    "pdf_bookmark_errors_fail_final_qa_and_restore_snapshot": true,
    "pdf_export": true
  },
  "qualification": {
    "mode": {"allowed": ["off", "shadow", "enforced"], "default": "enforced"},
    "enforce_default": true,
    "skip_mismatch_requested_default": true,
    "not_evaluated_action": {"allowed": ["hold_changes", "continue_with_review"], "default": "hold_changes"},
    "title_source": "unique_paired_txt_filename_stem_only",
    "pairing": "strict_directory_local_one_to_one_txt_and_manual_docx; missing_or_ambiguous_is_NOT_EVALUATED",
    "body_extraction": "complete_visible_OOXML_body_paragraph_text_in_source_order_including_tables_and_structure_fields; no_sampling_summary_or_silent_truncation",
    "semantic_statuses": ["MATCH", "MISMATCH"],
    "operational_statuses": ["NOT_EVALUATED"],
    "score_judgment": "one_typesafe_jev_score_on_domain_alignment_first_ordered_0_to_4_rubric; normalized_linearly_to_0_to_100; missing_individual_title_features_alone_does_not_mean_mismatch; one_configured_threshold_yields_MATCH_or_MISMATCH; confidence_is_monitoring_only",
    "evidence": "score_only_does_not_manufacture_paragraph_quotes_or_claim_evidence",
    "failure_separate_from_semantic_judgment": true,
    "input_overflow": "NOT_EVALUATED_INPUT_TOO_LARGE; preserve_complete_input_and_do_not_truncate",
    "cache_dependencies": ["title", "complete_body_text", "body_structure", "strategy_version", "provider", "pinned_model_id", "rubric_version_and_hash", "prompt_version", "policy_version", "threshold", "runtime_limits"],
    "cache_failures": "do_not_cache_NOT_EVALUATED_service_or_input_failures",
    "legacy_off_mode_similarity": "optional_uncalibrated_legacy_diagnostic_only",
    "cache_write_failure": "report_warning_and_continue_with_current_result",
    "output_selection": "MATCH_only; MISMATCH and NOT_EVALUATED remain in the original input and are not copied",
    "skip_scope": "exact_associated_files_in_shared_directories; copy_complete_isolated_project_directories_only_when_every_scanned_project_beneath_them_is_MATCH",
    "retain_original_in_output": false,
    "output_counts": {
      "qualified": "number_of_MATCH_projects_copied_for_processing",
      "total": "number_of_title_body_project_records_before_filtering_including_MISMATCH_and_NOT_EVALUATED"
    },
    "read_only_scan_when_manual_stage_unselected": true,
    "report_fields": ["mode", "provider", "model_id", "prompt_version", "policy_version", "projects", "semantic_status", "classification_method", "diagnostic_code", "failure_count", "action", "associated_files", "score_raw", "score_0_100", "score_probabilities", "confidence", "decision_threshold", "threshold_calibrated", "usage", "elapsed_ms", "request_characters", "cache_enabled", "cache_failure_count", "cache_hit_count", "model_request_count"],
    "match_only_output_requires_valid_match": true,
    "include_topic_mismatch_flag_overrides_match_only_output": true,
    "mismatch_clipboard": {
      "trigger": "apply_after_title_body_qualification_before_remaining_stages",
      "owner_window": "valid_temporary_hidden_window",
      "included_status": "MISMATCH",
      "text_template": "其余材料正在处理，以下材料不匹配：\\n{name_per_line}",
      "no_mismatch": "do_not_write_clipboard",
      "preview": "report_only_do_not_write_clipboard",
      "write_failure": "record_in_report_and_continue_processing",
      "report_fields": ["mismatch_names", "mismatch_clipboard.status", "mismatch_clipboard.text", "mismatch_clipboard.error"]
    },
    "thirteen_item_user_fixture": "tests/fixtures/title_body/beijing_qinyun_20260926_labels.json",
    "enforced_release_requires_independent_heldout_acceptance": true
  },
  "name_consistency": {
    "rule_version": "software-name-consistency-v2",
    "warning_fields": ["findings", "warning_count"],
    "pending_fields": ["review_findings", "review_count"],
    "pending_status": "PENDING_REVIEW",
    "pending_display": "collapsed_details_not_counted_as_warning",
    "decision_scope": "explicit_product_identity_evidence_only",
    "additional_model_requests": 0,
    "affects_material_selection": false
  },
  "ocr_company_keyword_alert": {
    "trigger": "OCR sample text contains literal 公司",
    "input": "existing sampled image OCR output",
    "additional_ocr_or_model_calls": 0,
    "display": "red report warning with project, image, matched OCR lines",
    "selection_effect": "review_only_no_automatic_skip_or_write",
    "coverage": "sampled_images_only"
  },
  "vision": {
    "protocol": "openai_compatible_chat_completions",
    "configuration_file": "vision_config.json",
    "api_key_pool_supported": true,
    "image_payload": "resized_jpeg_base64_data_url",
    "payload_size_limit_configurable": true,
    "http_error_body_in_report": true,
    "secrets_redacted_from_report": true,
    "vision_verdict_blocks_ocr_or_date_writes": false
  },
  "txt": {
    "implemented": true,
    "read_content": true,
    "modify_content": true,
    "scope": ["主要功能", "软件主要功能"],
    "repairs": ["parentheses_to_chinese_comma", "remove_double_quotes", "collapse_repeated_punctuation"],
    "preserve_ordinal_markers": true,
    "preserve_original_encoding": true,
    "preserve_non_target_fields": true,
    "preview_before_apply": true,
    "per_file_report": true,
    "skip_topic_mismatch_default": true,
    "legacy_stage_alias": "txt_placeholder"
  },
  "output": {
    "copy_count": 1,
    "timestamped_directory": true,
    "repack_rar": false
  }
}
